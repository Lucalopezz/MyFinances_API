PORT=3001
DATABASE_URL=

JWT_SECRET=your-jwt-secret
JWT_TOKEN_AUDIENCE=myfinances
JWT_TOKEN_ISSUER=myfinances-api
JWT_TTL=3600
JWT_REFRESH_TTL=86400

FINANCIAL_DATA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

REDIS_URL=redis://localhost:6379
EXPORT_STORAGE_PATH=./storage/exports
TRANSACTION_EXPORT_BATCH_SIZE=500

# Bancos descartáveis das suítes; exigem MongoDB local. Nunca usam DATABASE_URL.
# Para personalizar os testes, exporte estas variáveis no shell ao executar o comando.
TEST_DATABASE_URL=mongodb://127.0.0.1:27028/?replicaSet=rs0&directConnection=true
TEST_REDIS_URL=redis://127.0.0.1:6380
CARDS_TEST_DATABASE_URL=mongodb://127.0.0.1:27028/?replicaSet=rs0&directConnection=true
CALENDAR_TEST_DATABASE_URL=mongodb://127.0.0.1:27028/?replicaSet=rs0&directConnection=true
IMPORT_TEST_DATABASE_URL=mongodb://127.0.0.1:27028/?replicaSet=rs0&directConnection=true
NOTIFICATIONS_TEST_DATABASE_URL=mongodb://127.0.0.1:27028/?replicaSet=rs0&directConnection=true

# Banco aleatório e descartável para validar concorrência de reservas e compras.
WISHLIST_TEST_DATABASE_URL=mongodb://127.0.0.1:27028/?replicaSet=rs0&directConnection=true
