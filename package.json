{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.{ts,cjs}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "setup:local": "node scripts/setup-local-env.cjs",
    "db:local": "docker compose -f docker-compose.local.yml up -d --wait",
    "db:local:stop": "docker compose -f docker-compose.local.yml stop",
    "seed:test-transactions": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register scripts/seed-test-transactions.ts",
    "lint": "eslint \"{src,apps,libs,tests}/**/*.ts\" --fix",
    "test": "jest --config tests/jest-unit.config.cjs",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --runInBand --coverage",
    "test:cov:all": "jest --config tests/jest-coverage.config.cjs --runInBand",
    "test:debug": "node --inspect-brk node_modules/jest/bin/jest.js --config tests/jest-unit.config.cjs --runInBand",
    "test:e2e": "jest --config tests/jest-e2e.config.cjs --runInBand",
    "test:calendar:integration": "npm run test:integration -- --runTestsByPath tests/integration/modules/calendar/calendar.integration.spec.ts",
    "test:imports:integration": "npm run test:integration -- --runTestsByPath tests/integration/modules/transactions/imports/imports.integration.spec.ts",
    "test:notifications:integration": "npm run test:integration -- --runTestsByPath tests/integration/modules/notifications/notification.integration.spec.ts",
    "test:cards:integration": "npm run test:integration -- --runTestsByPath tests/integration/modules/cards/cards.integration.spec.ts",
    "test:wishlist:integration": "npm run test:integration -- --runTestsByPath tests/integration/modules/wishlist/wishlist.integration.spec.ts",
    "test:unit": "npm test -- --runInBand",
    "test:integration": "jest --config tests/jest-integration.config.cjs --runInBand",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.80.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.19.1",
    "prisma": "^6.4.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
